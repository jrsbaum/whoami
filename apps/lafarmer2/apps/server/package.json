{
  "name": "@lafarmer2/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:content": "npm --prefix ../../packages/content run build",
    "build": "npm run build:content && tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "npm run build:content && vitest run --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@lafarmer2/content": "file:../../packages/content",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
